# ============================================================
# GhostTrace — Environment Configuration Template
# Copy this file to .env and fill in your values:  cp .env.example .env
# ============================================================

# --- LLM Provider ---
# Options: "openai" | "ollama" | "longcat"
LLM_PROVIDER=openai

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
# OpenAI-compatible API — get your key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Available models (examples):
#   meta-llama/llama-3.1-8b-instruct:free   (free tier)
#   anthropic/claude-3.5-sonnet             (premium)
#   openai/gpt-4o                           (premium)
#   google/gemma-3-27b-it:free              (free tier)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# No key needed — make sure ollama is running: `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Volatility ---
# Full path to vol.py (Volatility 3) or vol2.py (Volatility 2) executable
VOLATILITY_PATH=C:/volatility3/vol.py
# Options: "vol3" | "vol2"
VOLATILITY_VERSION=vol3
# Timeout (seconds) for all Volatility plugins (default: 120)
VOL_TIMEOUT=120
# Timeout for netscan specifically — it is much slower on large dumps (default: 1800)
NETSCAN_TIMEOUT=1800

# --- Memory Dump ---
# Default dump path (can be overridden via CLI --dump flag)
MEMORY_DUMP_PATH=

# --- Output ---
# Directory where reports are saved
REPORT_OUTPUT_DIR=./output
